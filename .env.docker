# ============================================================
# File ini adalah template .env untuk deployment dengan Docker
# Salin file ini menjadi .env di VPS/server:
#   cp .env.docker .env
# Kemudian sesuaikan nilai-nilainya.
# ============================================================

APP_NAME="Inventory Control System"
APP_VERSION="1.0.0"
APP_ENV=production
APP_KEY=                          # generate dengan: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://your-domain.com    # ganti dengan domain/IP VPS Anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -------------------------------------------------------
# Database - HOST harus "db" (nama service di docker-compose)
# -------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inventory_control
DB_USERNAME=postgres
DB_PASSWORD=ganti_dengan_password_kuat_anda

# -------------------------------------------------------
# Session & Cache
# -------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# -------------------------------------------------------
# Mail (opsional, aktifkan jika butuh fitur email)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------
# JWT
# -------------------------------------------------------
JWT_SECRET=                      # generate dengan: php artisan jwt:secret --show

# -------------------------------------------------------
# Nginx port (default 80, ganti jika port 80 sudah dipakai)
# -------------------------------------------------------
NGINX_PORT=80
